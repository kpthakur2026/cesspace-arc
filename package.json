{
  "name": "cesspace-arc",
  "version": "0.1.0-rc01",
  "description": "Secure, vendor-neutral agent-to-machine control plane for AI agents, development environments, and remote systems using MCP",
  "license": "Apache-2.0",
  "author": "P Thakur",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^12.4.2"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "check": "pnpm run check:format && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:git && pnpm run check:secrets && pnpm audit",
    "check:format": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "node --test tests/protocol-contracts.test.js tests/rc01-negative-controls.test.js",
    "bench:rc01": "node benchmarks/rc01-benchmark.js",
    "check:docs": "bash scripts/check-docs.sh",
    "check:secrets": "bash scripts/check-secrets.sh",
    "check:git": "git diff --check",
    "audit": "pnpm audit",
    "verify:rc00": "bash scripts/verify-rc00.sh",
    "verify:rc01": "bash scripts/verify-rc01.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
