# ARC-INTEGRATION-01
# ChatGPT connection selectors only. Core workspace/policy/audit authority lives in core-config.json.
# Do NOT place the bearer token itself in this file.

CESSPACE_ARC_CHATGPT_TOKEN_FILE=/home/example-user/.cesspace-arc/chatgpt-token
CESSPACE_ARC_CHATGPT_PORT=4318

# Optional. Keep the adapter on loopback unless a reviewed private-network bind is required.
# CESSPACE_ARC_CHATGPT_BIND_HOST=127.0.0.1

# Optional. Set when a private tunnel presents a stable Host value.
# CESSPACE_ARC_CHATGPT_TUNNEL_HOSTNAME=arc.example.private
