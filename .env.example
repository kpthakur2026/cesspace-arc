# CesSpace ARC — Sanitized Environment Template
# Copy to .env for local testing only. NEVER commit .env to public Git history.

# Transport and Server Mode
ARC_SERVER_TRANSPORT=stdio
ARC_SERVER_HOST=127.0.0.1
ARC_SERVER_PORT=8443

# Workspace Configuration (Single canonical path or comma-separated list)
ARC_AUTHORIZED_WORKSPACE_ROOTS=/home/example-user/workspace/example-repo

# Policy and Security Settings
ARC_POLICY_FILE=examples/policies/policy.example.yaml
ARC_DEFAULT_POLICY=DENY

# Audit Logging
ARC_AUDIT_ENABLED=true
ARC_AUDIT_LOG_DIR=/tmp/cesspace-arc-audit
ARC_AUDIT_REDACTION=true

# Execution Limits
ARC_MAX_PAYLOAD_SIZE_BYTES=4194304
ARC_COMMAND_TIMEOUT_SECONDS=30
ARC_MAX_FILE_READ_BYTES=1048576
